# Copie para .env e preencha. NUNCA versionar o .env.
# Gerar a SECRET_KEY com:
#   backend/.venv/bin/python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
DEBUG=True

# Hosts separados por vírgula (ex.: localhost,192.168.0.30,checkin.example.com)
# No LAN do evento, inclua o IP do servidor (ex.: 192.168.0.30).
# O IP da máquina muda por DHCP — confira com: ip addr / ifconfig
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.30,192.168.0.10

# PostgreSQL
DB_NAME=postgres
DB_USER=u0_a382
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS (origem do PWA; separar por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Modo evento em rede local: DEBUG=False + LAN_INSECURE=1 libera HTTP puro
# (http://IP:8000) para o app nativo — desliga redirect/HSTS/cookies secure.
# Nunca habilitar em produção pública.
LAN_INSECURE=0

# Chave Ed25519 do QR/JWT (gerada pelo M2; caminho relativo a backend/)
# ED25519_PATH=secrets/ed25519_private.pem
# ED25519_PUB_PATH=secrets/ed25519_public.pem

# Salt do hash de IP no AuditLog (LGPD): trocar em produção
IP_HASH_SALT=dev-salt-change-me

# TTL dos JWTs em horas (staff = fical/aplicador; team = portal)
STAFF_JWT_TTL_HOURS=12
TEAM_JWT_TTL_HOURS=12

# Cutoff da inscrição online (padrão de indústria p/ eventos pequenos): quantas
# horas antes da sessão o cadastro fecha (24h dá tempo de conferir/imprimir).
# 0 = inscrições valem até a meia-noite do dia da sessão.
REGISTRATION_CUTOFF_HOURS=24
